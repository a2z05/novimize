  {
    "id": "explorer.fileExtensions.show",
    "name": "Show File Extensions",
    "description": "Stops Explorer hiding the extension on file names (Explorer\\Advanced\\HideFileExt). Without it a file called invoice.pdf.exe is read as a PDF by anyone glancing at it. Folder Options > View offers the same checkbox, and it is a per-user setting, so nothing about the machine changes.",
    "category": "explorer",
    "subcategory": "file-names",
    "risk": "Recommended",
    "evidence": 5,
    "tags": [
      "explorer",
      "usability",
      "security"
    ],
    "method": "Registry",
    "targetValue": "0",
    "defaultValue": "1",
    "params": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "registryValue": "HideFileExt",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "registryValue": "HideFileExt",
      "expectedApplied": "0",
      "expectedDefault": "1"
    },
    "apply": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "registryValue": "HideFileExt",
      "registryData": "0",
      "registryType": "DWORD"
    },
    "rollback": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "registryValue": "HideFileExt",
      "registryData": "1",
      "registryType": "DWORD"
    },
    "verify": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "registryValue": "HideFileExt",
      "expectedApplied": "0"
    }
  },
