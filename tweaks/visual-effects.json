  {
    "id": "visual.transparency.disabled",
    "name": "Disable Transparency Effects",
    "description": "Turns off the acrylic and blur Windows applies to the Start menu, taskbar and window frames (Themes\\Personalize\\EnableTransparency). Purely cosmetic: it removes a per-frame composition cost that is measurable mainly on integrated graphics, and it makes the desktop read as solid colour instead of frosted glass. Windows exposes the identical switch at Settings > Accessibility > Visual effects > Transparency effects.",
    "category": "visual-effects",
    "subcategory": "transparency",
    "risk": "Safe",
    "evidence": 5,
    "tags": [
      "visual-effects",
      "performance",
      "gpu"
    ],
    "method": "Registry",
    "targetValue": "0",
    "defaultValue": "1",
    "params": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "registryValue": "EnableTransparency",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "registryValue": "EnableTransparency",
      "expectedApplied": "0",
      "expectedDefault": "1"
    },
    "apply": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "registryValue": "EnableTransparency",
      "registryData": "0",
      "registryType": "DWORD"
    },
    "rollback": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "registryValue": "EnableTransparency",
      "registryData": "1",
      "registryType": "DWORD"
    },
    "verify": {
      "registryKey": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "registryValue": "EnableTransparency",
      "expectedApplied": "0"
    }
  },
