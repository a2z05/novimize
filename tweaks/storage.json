  {
    "id": "storage.writeCaching.enabled",
    "name": "Write Caching Enabled",
    "description": "Enables write caching on storage devices. Data is held in a cache buffer before being written to disk, improving I/O performance. Safe on systems with battery backup or UPS.",
    "category": "storage",
    "subcategory": "write-caching",
    "risk": "Recommended",
    "evidence": 5,
    "minBuild": 0,
    "tags": [
      "storage",
      "performance",
      "io"
    ],
    "method": "Registry",
    "targetValue": "1",
    "defaultValue": "0",
    "params": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceClasses\\{77cc37ce-880f-11d9-b819-0022488d7e2c}",
      "registryValue": "UserWriteCacheSetting",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceClasses\\{77cc37ce-880f-11d9-b819-0022488d7e2c}",
      "registryValue": "UserWriteCacheSetting",
      "expectedApplied": "1",
      "expectedDefault": "0"
    },
    "apply": {
      "command": "Get-WmiObject -Class Win32_DiskDrive | ForEach-Object { $di = [System.IO.Disk]::GetDeviceProperties($_.DeviceID); if ($di.WriteCacheEnabled -ne $null) { Set-Disk -Number $_.Index -IsWriteCacheEnabled $true } }"
    },
    "rollback": {
      "command": "Get-WmiObject -Class Win32_DiskDrive | ForEach-Object { Set-Disk -Number $_.Index -IsWriteCacheEnabled $false }"
    },
    "verify": {
      "command": "Get-Disk | Select-Object Number, FriendlyName, IsWriteCacheEnabled"
    },
    "profiles": [
      "gaming",
      "workstation",
      "developer"
    ]
  },
  {
    "id": "storage.ntfs.lastAccess.disabled",
    "name": "Disable NTFS Last Access Timestamp",
    "description": "Disables NTFS updating the last access timestamp on every file read. Reduces unnecessary disk I/O, especially beneficial for systems with heavy file access patterns like databases or dev environments.",
    "category": "storage",
    "subcategory": "ntfs",
    "risk": "Safe",
    "evidence": 5,
    "minBuild": 0,
    "tags": [
      "storage",
      "performance",
      "ntfs",
      "io"
    ],
    "method": "PowerShell",
    "targetValue": "1",
    "defaultValue": "0",
    "params": {
      "detectCommand": "$v = (Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -ErrorAction SilentlyContinue).NtfsDisableLastAccessUpdate; if ($null -eq $v) { '0' } elseif (($v -band 0x7FFFFFFF) -eq 1) { '1' } else { '0' }",
      "applyCommand": "Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -Value 1 -Type DWord -ErrorAction Stop",
      "rollbackCommand": "Remove-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -ErrorAction SilentlyContinue"
    },
    "detect": {
      "command": "$v = (Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -ErrorAction SilentlyContinue).NtfsDisableLastAccessUpdate; if ($null -eq $v) { '0' } elseif (($v -band 0x7FFFFFFF) -eq 1) { '1' } else { '0' }",
      "extractPattern": "([01])",
      "expectedApplied": "1",
      "expectedDefault": "0"
    },
    "apply": {
      "command": "Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -Value 1 -Type DWord -ErrorAction Stop"
    },
    "rollback": {
      "command": "Remove-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -ErrorAction SilentlyContinue"
    },
    "verify": {
      "command": "$v = (Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem' -Name NtfsDisableLastAccessUpdate -ErrorAction SilentlyContinue).NtfsDisableLastAccessUpdate; if ($null -eq $v) { '0' } elseif (($v -band 0x7FFFFFFF) -eq 1) { '1' } else { '0' }",
      "extractPattern": "([01])",
      "expectedApplied": "1"
    },
    "profiles": [
      "gaming",
      "workstation",
      "developer"
    ]
  },
