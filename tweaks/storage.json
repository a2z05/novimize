  {
    "id": "storage.searchIndexing.disabled",
    "name": "Disable Windows Search Indexing",
    "description": "Stops and disables the Windows Search Indexer service (WSearch). On SSDs, the random access speed makes indexing unnecessary and it wastes CPU and disk I/O. Search still works, just slower.",
    "category": "storage",
    "subcategory": "search-indexing",
    "risk": "Optional",
    "evidence": 4,
    "minBuild": 0,
    "tags": [
      "storage",
      "performance",
      "ssd",
      "cpu"
    ],
    "method": "PowerShell",
    "targetValue": "Disabled",
    "defaultValue": "Auto",
    "params": {
      "serviceName": "WSearch",
      "detectCommand": "(Get-Service WSearch).StartType",
      "applyCommand": "Stop-Service -Name WSearch -Force -ErrorAction SilentlyContinue; Set-Service -Name WSearch -StartupType Disabled",
      "rollbackCommand": "Set-Service -Name WSearch -StartupType Automatic; Start-Service -Name WSearch -ErrorAction SilentlyContinue"
    },
    "detect": {
      "command": "(Get-Service WSearch).StartType",
      "extractPattern": "(\\w+)",
      "expectedApplied": "Disabled",
      "expectedDefault": "Automatic"
    },
    "apply": {
      "command": "Stop-Service -Name WSearch -Force -ErrorAction SilentlyContinue; Set-Service -Name WSearch -StartupType Disabled"
    },
    "rollback": {
      "command": "Set-Service -Name WSearch -StartupType Automatic; Start-Service -Name WSearch -ErrorAction SilentlyContinue"
    },
    "verify": {
      "command": "(Get-Service WSearch).StartType",
      "extractPattern": "(\\w+)",
      "expectedApplied": "Disabled"
    },
    "profiles": [
      "gaming",
      "workstation"
    ]
  },
