[
  {
    "id": "startup.oneDrive.disabled",
    "name": "Disable OneDrive Auto-Start",
    "description": "Prevents OneDrive from launching at Windows startup. OneDrive runs a background sync process that consumes CPU, memory, and network bandwidth. Disable if you don't use OneDrive cloud storage.",
    "category": "startup",
    "subcategory": "auto-start",
    "risk": "Safe",
    "evidence": 5,
    "minBuild": 0,
    "tags": [
      "startup",
      "performance",
      "memory",
      "cloud"
    ],
    "method": "Registry",
    "targetValue": "1",
    "defaultValue": "0",
    "params": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "registryValue": "DisableFileSyncNGSC",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "registryValue": "DisableFileSyncNGSC",
      "expectedApplied": "1",
      "expectedDefault": "0"
    },
    "apply": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "registryValue": "DisableFileSyncNGSC",
      "registryData": "1",
      "registryType": "DWORD"
    },
    "rollback": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "registryValue": "DisableFileSyncNGSC",
      "registryData": "0",
      "registryType": "DWORD"
    },
    "verify": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "registryValue": "DisableFileSyncNGSC",
      "expectedApplied": "1"
    }
  },
