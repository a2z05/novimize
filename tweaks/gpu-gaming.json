  {
    "id": "gpu.gaming.hags",
    "name": "Hardware Accelerated GPU Scheduling",
    "description": "Enables Hardware Accelerated GPU Scheduling (HAGS). Allows the GPU to manage its own video memory scheduling, reducing latency and improving performance in GPU-bound scenarios. Requires restart.",
    "category": "gpu-gaming",
    "subcategory": "gpu-scheduling",
    "risk": "Recommended",
    "evidence": 5,
    "minBuild": 19041,
    "tags": [
      "gpu",
      "gaming",
      "performance",
      "latency"
    ],
    "method": "Registry",
    "targetValue": "1",
    "defaultValue": "0",
    "params": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "registryValue": "HwSchMode",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "registryValue": "HwSchMode",
      "expectedApplied": "1",
      "expectedDefault": "0"
    },
    "apply": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "registryValue": "HwSchMode",
      "registryData": "1",
      "registryType": "DWORD"
    },
    "rollback": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "registryValue": "HwSchMode",
      "registryData": "0",
      "registryType": "DWORD"
    },
    "verify": {
      "registryKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "registryValue": "HwSchMode",
      "expectedApplied": "1"
    }
