  {
    "id": "privacy.telemetry.level",
    "name": "Telemetry Level - Security Only",
    "description": "Sets Windows telemetry collection to Security level (0), the minimum. Only sends required security data to Microsoft. No diagnostic or usage data is collected.",
    "category": "privacy",
    "subcategory": "telemetry",
    "risk": "Safe",
    "evidence": 5,
    "minBuild": 0,
    "tags": [
      "privacy",
      "telemetry",
      "data-collection"
    ],
    "method": "Registry",
    "targetValue": "0",
    "defaultValue": "3",
    "params": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "registryValue": "AllowTelemetry",
      "registryType": "DWORD"
    },
    "detect": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "registryValue": "AllowTelemetry",
      "expectedApplied": "0",
      "expectedDefault": "3"
    },
    "apply": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "registryValue": "AllowTelemetry",
      "registryData": "0",
      "registryType": "DWORD"
    },
    "rollback": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "registryValue": "AllowTelemetry",
      "registryData": "3",
      "registryType": "DWORD"
    },
    "verify": {
      "registryKey": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "registryValue": "AllowTelemetry",
      "expectedApplied": "0"
    }
  },
