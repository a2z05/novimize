    "targetValue": "normal",
    "defaultValue": "normal",
    "params": {},
    "detect": {
      "command": "int tcp show global",
      "extractPattern": "Receive Window Auto-Tuning(?:\\s+Level)?\\s+:\\s+(\\S+)",
      "expectedApplied": "normal",
      "expectedDefault": "normal"
    },
    "apply": {
      "command": "int tcp set global autotuninglevel=normal"
