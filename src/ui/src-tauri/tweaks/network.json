    "id": "network.tcpip.dca",
    "name": "Direct Cache Access (DCA)",
    "description": "Enables Direct Cache Access, letting receive buffers be placed directly in CPU cache instead of an intermediate copy. Windows already enables this per-NIC on supported hardware, so this only re-applies the state; it is skipped on NICs that do not support DCA.",
    "category": "network",
    "subcategory": "tcpip",
    "risk": "Safe",
    "evidence": 2,
    "minBuild": 0,
    "tags": [
      "network",
      "performance"
    ],
    "method": "NetSh",
    "targetValue": "enabled",
    "defaultValue": "enabled",
    "detect": {
      "command": "int tcp show global",
      "extractPattern": "Direct Cache Access \\(DCA\\)\\s+:\\s+(\\S+)",
      "expectedApplied": "enabled",
      "expectedDefault": "enabled"
    },
    "apply": {
      "command": "int tcp set global dca=enabled"
    },
    "rollback": {
      "command": "int tcp set global dca=enabled"
    },
    "profiles": [
      "gaming",
      "workstation"
    ]
  },
  {
    "id": "network.tcpip.rsc",
    "name": "Receive Segment Coalescing (RSC)",
    "description": "Coalesces multiple TCP segments into one before handing them up the stack, which cuts per-packet processing overhead. This can be counterproductive for gaming and high-RTT links, where it delays the first bytes of a response.",
    "category": "network",
    "subcategory": "tcpip",
    "risk": "Optional",
    "evidence": 3,
    "minBuild": 0,
    "tags": [
      "network",
      "performance",
      "latency"
    ],
    "method": "NetSh",
    "targetValue": "disabled",
    "defaultValue": "enabled",
    "detect": {
      "command": "int tcp show global",
      "extractPattern": "Receive Segment Coalescing\\s+State\\s+:\\s+(\\S+)",
      "expectedApplied": "disabled",
      "expectedDefault": "enabled"
    },
    "apply": {
      "command": "int tcp set global rsc=disabled"
    },
    "rollback": {
      "command": "int tcp set global rsc=enabled"
    },
    "verify": {
      "command": "int tcp show global",
      "extractPattern": "Receive Segment Coalescing\\s+State\\s+:\\s+(\\S+)",
      "expectedApplied": "disabled"
    },
