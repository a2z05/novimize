  {
    "id": "network.tcpip.windowScalingHeuristics",
    "name": "TCP Window Scaling Heuristics",
    "description": "Windows scales back receive window auto-tuning on short, bursty connections such as gaming and VPN tunnels, which costs throughput. Disabling the heuristics lets every connection keep the auto-tuned window. The system default is 'enabled'; only run this to stop Windows from throttling those connections.",
    "category": "network",
    "subcategory": "tcpip",
    "risk": "Optional",
    "evidence": 3,
    "minBuild": 0,
    "tags": [
      "network",
      "performance",
      "gaming"
    ],
    "method": "NetSh",
    "targetValue": "disabled",
    "defaultValue": "enabled",
    "detect": {
      "command": "int tcp show heuristics",
      "extractPattern": "Window Scaling heuristics\\s+:\\s+(\\S+)",
      "expectedApplied": "disabled",
      "expectedDefault": "enabled"
    },
    "apply": {
      "command": "int tcp set heuristics disabled"
    },
    "rollback": {
      "command": "int tcp set heuristics enabled"
    },
    "verify": {
      "command": "int tcp show heuristics",
      "extractPattern": "Window Scaling heuristics\\s+:\\s+(\\S+)",
      "expectedApplied": "disabled"
    },
    "profiles": [
      "gaming",
      "streaming",
      "developer",
      "workstation"
    ]
  },
