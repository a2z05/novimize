    "description": "Sets DNS resolver to Cloudflare's fast and privacy-focused DNS. Improves DNS resolution speed.",
    "category": "network",
    "subcategory": "dns",
    "risk": "Safe",
    "evidence": 5,
    "minBuild": 0,
    "tags": [
      "network",
      "privacy",
      "performance"
    ],
    "method": "PowerShell",
    "targetValue": "1.1.1.1",
    "defaultValue": "",
    "params": {
      "detectCommand": "Get-DnsClientServerAddress | Where-Object {$_.InterfaceAlias -notlike 'Loopback*'} | Select-Object -First 1 -ExpandProperty ServerAddresses",
      "applyCommand": "$adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1; Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses ('1.1.1.1','1.0.0.1')",
      "rollbackCommand": "$adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1; Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ResetServerAddresses"
    },
    "detect": {
      "command": "Get-DnsClientServerAddress | Where-Object {$_.InterfaceAlias -notlike 'Loopback*'} | Select-Object -First 1 -ExpandProperty ServerAddresses",
      "extractPattern": "([\\d.]+)",
      "expectedApplied": "1.1.1.1"
    },
    "apply": {
      "command": "$adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1; Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses ('1.1.1.1','1.0.0.1')"
    },
    "rollback": {
      "command": "$adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1; Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ResetServerAddresses"
    },
    "verify": {
      "command": "Get-DnsClientServerAddress | Where-Object {$_.InterfaceAlias -notlike 'Loopback*'} | Select-Object -First 1 -ExpandProperty ServerAddresses",
      "extractPattern": "([\\d.]+)",
      "expectedApplied": "1.1.1.1"
    },
