<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\core\WinOpt.Core.csproj" />
    <ProjectReference Include="..\providers\WinOpt.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.*" />
    <PackageReference Include="System.Management" Version="8.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Game mode's capture → apply → restore is the safety property of the whole
    feature, and the only way to test it is to run it against a key the test
    owns. Those three steps are exposed to the test assembly and to nothing else.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="WinOpt.Core.Tests" />
  </ItemGroup>

</Project>
